# Cloudflare Workers Static Assets headers (static assets only; there is no Worker script).
# __SUPABASE_ORIGIN__ and __SUPABASE_WS_ORIGIN__ (Realtime) are rendered by the web build (apps/web/vite.config.ts; tools/render-headers.ts re-renders idempotently) with the https and wss origins of VITE_SUPABASE_URL.
# Strict-Transport-Security is managed in the Cloudflare dashboard (SSL/TLS, Edge Certificates, HSTS).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), camera=(), clipboard-write=(self), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' __SUPABASE_ORIGIN__ __SUPABASE_WS_ORIGIN__; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/auth/*
  Cache-Control: no-store
/theme-init.js
  Cache-Control: no-cache
