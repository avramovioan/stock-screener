# Local Edge Function secrets. Copy to supabase/functions/.env (git-ignored); never commit values.
CRON_SHARED_SECRET=local-dev-cron-secret
SEC_USER_AGENT=
SITE_URL=http://localhost:5173

# Optional exact `iss` of user JWTs. Unset: SUPABASE_URL + /auth/v1 (production). Local stack: Auth issues
# http://127.0.0.1:54321/auth/v1 but the functions see SUPABASE_URL=http://kong:8000, so set this locally.
JWT_ISSUER=

# Local-only fixture mode for tools/run-local-scan.ts. Never set ALLOW_FIXTURE_PROVIDERS as a hosted secret.
ALLOW_FIXTURE_PROVIDERS=1

# Public quotes function: random string, at least 32 characters (supabase secrets set in production).
RATE_LIMIT_SALT=

# P2 research (SEC_USER_AGENT above is shared with EDGAR). Names only: an unset key makes the provider "not configured"
# and reports end as quota_deferred / provider_not_configured instead of failing.
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PRIMARY=gemini
# The backup model. Groq free tier: LLM_ALT_PROVIDER=groq, LLM_ALT_BASE_URL=https://api.groq.com/openai/v1,
# LLM_ALT_MODEL=openai/gpt-oss-120b (8,000 tokens per minute, so set the two budgets below).
LLM_ALT_PROVIDER=
LLM_ALT_BASE_URL=
LLM_ALT_API_KEY=
LLM_ALT_MODEL=
# Optional request budget of the backup (empty = unlimited). Groq free: 4500 input + 3000 output stays under 8,000 tokens per minute.
LLM_ALT_MAX_INPUT_TOKENS=
LLM_ALT_MAX_OUTPUT_TOKENS=
# Optional: low | medium | high. Empty = "low" for an openai/gpt-oss* model, nothing for any other model.
LLM_ALT_REASONING_EFFORT=
TAVILY_API_KEY=
JINA_API_KEY=

# P5b Flex
FLEX_ENC_KEY_V1=
FLEX_ENC_KEY_CURRENT=1
FLEX_USER_AGENT=PersonalStockScreener/1.0
# 1 only for the local integration run (refused unless SUPABASE_URL is local)
FLEX_FIXTURE_MODE=

# P3 notifications. Names only; generate values per docs/operator-guide.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional: comma-separated extra push-service hosts accepted by push-subscribe
PUSH_ENDPOINT_EXTRA_HOSTS=
