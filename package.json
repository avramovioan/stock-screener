{
  "name": "personal-stock-screener",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.1"
  },
  "trustedDependencies": [
    "supabase"
  ],
  "scripts": {
    "dev": "bun run --filter @screener/web dev",
    "build": "bun run --filter @screener/web build && bun run render:headers && bun run check:bundle && bun run check:headers",
    "lint": "biome ci .",
    "types:gen": "bunx supabase gen types typescript --local --schema public > apps/web/src/lib/database.types.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint:workflows": "bun run tools/validate-workflows.ts",
    "typecheck": "tsc -p apps/web --noEmit && tsc -p supabase/functions/_shared/core --noEmit && tsc -p tsconfig.json --noEmit && bun run tools/check-core-purity.ts",
    "test": "bun run test:core && bun run test:tools && bun run test:web && bun run functions:test",
    "test:core": "vitest run --project core",
    "test:tools": "vitest run --project tools",
    "test:web": "vitest run --project web",
    "test:db": "supabase test db",
    "e2e:setup": "bun run tools/e2e-setup.ts",
    "test:e2e:local": "bun run tools/e2e-setup.ts --ensure && bun run --filter @screener/web e2e:local",
    "test:e2e": "VITE_SUPABASE_URL=https://csp-e2e.supabase.co VITE_SUPABASE_ANON_KEY=csp-e2e-anon VITE_SITE_URL=https://csp-e2e.example.com bun run build && bun run --filter @screener/web e2e",
    "render:headers": "bun run tools/render-headers.ts",
    "check:headers": "bun run tools/check-headers.ts",
    "audit": "bun run tools/audit-deps.ts",
    "keepalive": "bun run tools/keepalive.ts",
    "check:secrets": "bun run tools/check-secret-inventory.ts",
    "check:fetch": "bun run tools/check-fetch-callsites.ts",
    "probe:ratelimit": "bun run tools/probe-rate-limit.ts",
    "check:bundle": "bun run tools/check-bundle-secrets.ts",
    "check:auth-config": "bun run tools/check-auth-config.ts",
    "check:functions-config": "bun run tools/check-functions-config.ts",
    "functions:check": "deno check --config supabase/functions/deno.json \"supabase/functions/**/*.ts\" \"!supabase/functions/_shared/core/**/*.test.ts\"",
    "functions:test": "deno test -A --config supabase/functions/deno.json --ignore=supabase/functions/_shared/core supabase/functions",
    "functions:selftest": "bun run tools/functions-check-selftest.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:serve": "supabase functions serve --no-verify-jwt",
    "gen:icons": "bun run tools/gen-icons.ts",
    "gen:vapid": "bun run tools/gen-vapid.ts",
    "spike:push": "bun run tools/spike-push.ts",
    "test:integration": "bun run tools/test-integration.ts && bun run tools/self-test/research.ts && bun run test:integration:notifications && bun run test:integration:broker",
    "test:integration:notifications": "bun run tools/integration/notifications.integration.ts",
    "test:integration:broker": "bun run tools/test-broker-integration.ts",
    "scan:local": "bun run tools/run-local-scan.ts",
    "gen:fixtures:yahoo": "bun run tools/build-yahoo-fixtures.ts",
    "gen:fixtures:world": "bun run tools/gen-integration-fixtures.ts",
    "gen:fixtures:eur": "bun run tools/gen-eur-fixtures.ts",
    "verify:all": "bun run tools/verify-all.ts",
    "parity": "bun run tools/parity-print.ts",
    "release:check": "bun run tools/release-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "supabase": "^2.121.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
